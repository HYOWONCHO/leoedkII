prefix=/opt/sbc-tpm2-build
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: tss2-tcti-null
Description: TCTI library which only provides TCTI initialization.
URL: https://github.com/tpm2-software/tpm2-tss
Version: leoedkII_tag_sbcpkg_v5.2.1-rc-9-g5cfa5f31-dirty
Requires.private: tss2-tctildr
Cflags: -I${includedir}
Libs: -ltss2-tcti-null -L${libdir}
