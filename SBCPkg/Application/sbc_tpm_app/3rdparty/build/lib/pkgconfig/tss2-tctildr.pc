prefix=/opt/sbc-tpm2-build
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${exec_prefix}/lib

Name: tss2-tctildr
Description: Library to simplify management of TCTIs.
URL: https://github.com/tpm2-software/tpm2-tss
Version: leoedkII_tag_sbcpkg_v5.2.1-rc-9-g5cfa5f31-dirty
Cflags: -I${prefix}/include -I${includedir}/tss2
Libs: -ltss2-tctildr -L${exec_prefix}/lib
