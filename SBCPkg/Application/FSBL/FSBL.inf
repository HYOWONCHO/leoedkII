[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = FSBL
  MODULE_UNI_FILE                = leo_test.uni
  FILE_GUID                      = 2eb48e1b-aaea-4557-bc78-bbe9e5c04328
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMain

  DEFINE UINT_TEST_ON            = TRUE


[Sources]
  FSBL.c
  SBC_Log.c
  SBC_CryptAES.c
  SBC_SystemControl.c
  SBC_FileCtrl.c
  SBC_EccSignVeriify.c
  SBC_Hashing.c
  SBC_AntiTampering.c
  SBC_X509.c
  SBC_LoadKernelImage.c 
  SBC_Nvram.c
  SBC_UnitTest.c
  #SBC_Tpm.c
  SBC_Timer.c
 
[Packages]
  MdePkg/MdePkg.dec
  ShellPkg/ShellPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  CryptoPkg/CryptoPkg.dec
  SecurityPkg/SecurityPkg.dec
  UefiPayloadPkg/UefiPayloadPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  BaseLib
  BaseMemoryLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  DebugLib
  UefiLib
  MemoryAllocationLib
  DxeServicesLib
  PrintLib
  RngLib
  BaseCryptLib
  HandleParsingLib
  PcdLib
  DevicePathLib
  IoLib
  UefiBootManagerLib
  FileHandleLib
  HiiLib
  SortLib
  UefiHiiServicesLib
  #Tpm2CommandLib
  #Tpm2DeviceLib


  #ShellLib
  #ShellCommandLib

  

[Guids]
  gEfiFileInfoGuid
  ## SOMETIMES_CONSUMES   ## GUID # Locate protocol
  ## SOMETIMES_CONSUMES   ## GUID # SmiHandlerRegister

  ##gEdkiiMemoryProfileGuid
  ##gEdkiiPiSmmCommunicationRegionTableGuid    ## SOMETIMES_CONSUMES ## SystemTable
  ##gEfiFileSystemVolumeLabelInfoIdGuid           # SOMETIMES_CONSUMED
  ##gEfiFileInfoGuid                              # SOMETIMES_CONSUMED
  ##gEfiFileSystemInfoGuid                        # SOMETIMES_CONSUME

[Ppis]

[Protocols]
  gEfiShellProtocolGuid
  gEfiShellParametersProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiSerialIoProtocolGuid
  gEfiNvmExpressPassThruProtocolGuid
  gEfiDevicePathToTextProtocolGuid


[FeaturePcd]

[Pcd]
  gEfiMdeModulePkgTokenSpaceGuid.PcdSerialRegisterBase
  gEfiMdePkgTokenSpaceGuid.PcdUefiLibMaxPrintBufferSize
  #gEfiSecurityPkgTokenSpaceGuid.PcdTpm2InterfaceType
  #gEfiSecurityPkgTokenSpaceGuid.PcdTpm2DebugLevel
	

[FixedPcd]
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultBaudRate
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultDataBits
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultParity
  gEfiMdePkgTokenSpaceGuid.PcdUartDefaultStopBits


[UserExtensions.TianoCore."ExtraFiles"]
  leo_test_extra.uni

[BuildOptions.X64]
  GCC:DEBUG_GCC5_X64_CC_FLAGS = -flto=4  -Werror=cpp 
  *_*_*_CC_FLAGS = -D_SBC_DEVID_VERIFY_
  *_*_*_CC_FLAGS = -D_SBC_DRIVER_LOAD_
  *_*_*_CC_FLAGS = -D_DEBUG_PRINT_ON_
